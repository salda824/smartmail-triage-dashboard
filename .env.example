# ---------------------------------------------------------------------------
# SmartMail Triage - variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ---------------------------------------------------------------------------

# Ruta del archivo SQLite (por defecto ./data/smartmail.db)
SMARTMAIL_DB_PATH=./data/smartmail.db

# --- Opcion A: IMAP con contrasena de aplicacion (la mas simple) ------------
# 1. Activa la verificacion en dos pasos de tu cuenta de Google
# 2. Crea una contrasena de aplicacion: https://myaccount.google.com/apppasswords
# 3. Pegala aqui (se aceptan los espacios que muestra Google)
# 4. Comprueba con: npm run imap:test
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Cuantos dias hacia atras leer en cada sincronizacion
IMAP_SINCE_DAYS=14

# --- Opcion B: Gmail API (OAuth 2.0) ----------------------------------------
# Crea un proyecto en https://console.cloud.google.com, habilita la Gmail API,
# y genera credenciales OAuth de tipo "Aplicacion de escritorio".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Refresh token obtenido con `npm run gmail:auth` (se guarda tambien en .gmail-token.json)
GOOGLE_REFRESH_TOKEN=

# Cuantos correos pedir a Gmail por sincronizacion
SYNC_MAX_RESULTS=80
# Consulta de Gmail usada por el sync (sintaxis del buscador de Gmail)
SYNC_QUERY=newer_than:14d

# Origen de datos:
#   imap   -> IMAP con contrasena de aplicacion (opcion A)
#   gmail  -> Gmail API por OAuth (opcion B)
#   bridge -> archivo JSON en BRIDGE_INBOX_PATH
#   demo   -> datos de ejemplo incluidos
# Si se deja vacio se elige solo segun las credenciales que encuentre.
MAIL_SOURCE=demo
# Ruta del archivo JSON cuando MAIL_SOURCE=bridge
BRIDGE_INBOX_PATH=./data/bridge-inbox.json
