# ---------------------------------------------------------------------------
# SmartMail Triage - variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ---------------------------------------------------------------------------

# Ruta del archivo SQLite (por defecto ./data/smartmail.db)
SMARTMAIL_DB_PATH=./data/smartmail.db

# --- Integracion Gmail (OAuth 2.0) ------------------------------------------
# Crea un proyecto en https://console.cloud.google.com, habilita la Gmail API,
# y genera credenciales OAuth de tipo "Aplicacion de escritorio".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Refresh token obtenido con `npm run gmail:auth` (se guarda tambien en .gmail-token.json)
GOOGLE_REFRESH_TOKEN=

# Cuantos correos pedir a Gmail por sincronizacion
SYNC_MAX_RESULTS=80
# Consulta de Gmail usada por el sync (sintaxis del buscador de Gmail)
SYNC_QUERY=newer_than:14d

# Modo de origen de datos: "gmail" (API real) | "bridge" (archivo JSON) | "demo" (datos de ejemplo)
MAIL_SOURCE=demo
# Ruta del archivo JSON cuando MAIL_SOURCE=bridge
BRIDGE_INBOX_PATH=./data/bridge-inbox.json
