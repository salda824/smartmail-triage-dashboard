{
  "name": "smartmail-triage",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard inteligente de clasificacion, resumen y gestion de correos de Gmail",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
